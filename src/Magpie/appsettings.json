{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ModuleParticipant": {
    "HostGrpcAddress": "https://localhost:5000",
    "WorkGrpcPort": 5001,
    "EnableRegistration": true
