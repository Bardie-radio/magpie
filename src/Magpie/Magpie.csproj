<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Magpie</RootNamespace>
    <AssemblyName>Magpie</AssemblyName>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="YoutubeExplode" />
    <PackageReference Include="FFmpeg.AutoGen" />
  </ItemGroup>

  <!-- Multi-root / Local Compose: sibling ProjectReference when Logos + source-kind exist. -->
  <ItemGroup Condition="'$(LogosPath)' != ''">
    <ProjectReference Include="$(LogosPath)/Bardie.Logos.Contracts/Bardie.Logos.Contracts.csproj" />
    <ProjectReference Include="$(LogosPath)/Bardie.Logos.Channel/Bardie.Logos.Channel.csproj" />
    <ProjectReference Include="$(LogosPath)/Bardie.Logos.Hosting/Bardie.Logos.Hosting.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(KitharaLogosSourcePath)' != ''">
    <ProjectReference Include="$(KitharaLogosSourcePath)/Bardie.Module.Source/Bardie.Module.Source.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(KitharaLogosSourcePath)' != '' and '$(Configuration)' == 'Debug'">
    <ProjectReference Include="$(KitharaLogosSourcePath)/Bardie.Module.Source.Debug/Bardie.Module.Source.Debug.csproj" />
  </ItemGroup>

  <!-- Standalone CI / published nupkgs. -->
  <ItemGroup Condition="'$(LogosPath)' == ''">
    <PackageReference Include="Bardie.Logos.Contracts" />
    <PackageReference Include="Bardie.Logos.Channel" />
    <PackageReference Include="Bardie.Logos.Hosting" />
  </ItemGroup>
  <ItemGroup Condition="'$(KitharaLogosSourcePath)' == ''">
    <PackageReference Include="Bardie.Module.Source" />
  </ItemGroup>

  <ItemGroup Condition="'$(KitharaLogosSourcePath)' == '' and '$(Configuration)' == 'Debug'">
    <PackageReference Include="Bardie.Module.Source.Debug" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="module.manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
